# Copy this file to `.env` and adjust values for local runs.
# The `.env` file is gitignored (it may hold secrets).

# ---------------------------------------------------------------------------
# Database (Postgres). docker-compose wires the app to the `db` service using
# these same values; for a local run point DATABASE_URL at your own Postgres.
# ---------------------------------------------------------------------------
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=ledgerly
POSTGRES_DB=ledgerly
DATABASE_URL=postgres://ledgerly:ledgerly@localhost:5432/ledgerly

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Secret used to sign the session cookie. Use a long random value in real life.
SESSION_SECRET=dev-only-change-me
PORT=3000

# The challenge flag. In Docker it is baked via `--build-arg FLAG=...` and the
# seed reads it from the environment. Never commit the real value.
FLAG=FLAG{LEDGERLY_BALANCE_EXPOSED}

# ---------------------------------------------------------------------------
# Traefik ACME DNS-01 (only needed for the full Traefik stack / Option B).
# Namecheap API credentials used to solve the challenge for *.iv0ks.dev.
# ---------------------------------------------------------------------------
NAMECHEAP_API_USER=<your-namecheap-username>
NAMECHEAP_API_KEY=<your-namecheap-api-key>
